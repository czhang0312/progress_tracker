<% reset_url = "#{ENV.fetch('FRONTEND_URL', 'http://localhost:3000')}/reset-password?token=#{@token}" %>
<% expires_in_hours = Devise.reset_password_within.to_i / 3600 %>
<div style="max-width: 480px; margin: 0 auto; padding: 8px; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1a1a1a; line-height: 1.6;">
  <h1 style="font-size: 20px; font-weight: 700; margin: 0 0 4px;">Progress Tracker</h1>
  <hr style="border: none; border-top: 1px solid #e5e5e5; margin: 12px 0 24px;">

  <p style="margin: 0 0 16px;">Hi <%= @resource.email %>,</p>

  <p style="margin: 0 0 16px;">We received a request to reset the password for your <strong>Progress Tracker</strong> account. Click the button below to choose a new password:</p>

  <p style="margin: 0 0 24px;">
    <a href="<%= reset_url %>" style="display: inline-block; background: #4f46e5; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 600;">Reset my password</a>
  </p>

  <p style="margin: 0 0 16px; font-size: 14px; color: #555;">
    Or copy and paste this link into your browser:<br>
    <a href="<%= reset_url %>" style="color: #4f46e5; word-break: break-all;"><%= reset_url %></a>
  </p>

  <p style="margin: 0 0 16px; font-size: 14px; color: #555;">
    This link expires in <%= expires_in_hours %> hours. If you didn't request a password reset, you can safely ignore this email &mdash; your password won't change until you create a new one.
  </p>

  <hr style="border: none; border-top: 1px solid #e5e5e5; margin: 24px 0 12px;">
  <p style="margin: 0; font-size: 12px; color: #999;">This email was sent by Progress Tracker. Please do not reply to this message.</p>
</div>
